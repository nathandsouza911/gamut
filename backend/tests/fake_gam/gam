#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
"""Fake `gam` for tests: records its arguments and replies from a scenario.

The runner gives GAM an exact, minimal environment, so the log and scenario files are
found next to this script (calls.jsonl, scenario.json); FAKE_GAM_LOG and
FAKE_GAM_SCENARIO override them when set. The `fake_gam` pytest fixture copies this
script and those files into a temporary directory.

Each log line is {"argv": [...], "env": {"GAMCFGDIR": ..., "TMPDIR": ..., "files": [...],
"keys": [...]}}.
Scenario: a JSON list of {"match": [argv prefix], "exit": int, "stdout": str,
"stderr": str, "sleep": float, "stdout_bytes": int}; the first match wins. The default
reply is exit 0 with empty output. `version` is never logged and always answers
"GAM 7.x.y - fake".
"""

import json
import os
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent


def main() -> int:
    argv = sys.argv[1:]
    if argv[:1] == ["version"]:
        sys.stdout.write("GAM 7.x.y - fake\n")
        return 0
    cfg = os.environ.get("GAMCFGDIR", "")
    try:
        files = sorted(os.listdir(cfg)) if cfg else []
    except OSError:
        files = []
    entry = {
        "argv": argv,
        "env": {
            "GAMCFGDIR": cfg,
            "TMPDIR": os.environ.get("TMPDIR"),
            "files": files,
            "keys": sorted(os.environ),
        },
    }
    log = Path(os.environ.get("FAKE_GAM_LOG") or HERE / "calls.jsonl")
    with log.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry) + "\n")
    scenario_path = Path(os.environ.get("FAKE_GAM_SCENARIO") or HERE / "scenario.json")
    scenario = json.loads(scenario_path.read_text("utf-8")) if scenario_path.exists() else []
    for rule in scenario:
        prefix = rule.get("match", [])
        if argv[: len(prefix)] == prefix:
            break
    else:
        rule = {}
    if rule.get("sleep"):
        time.sleep(float(rule["sleep"]))
    out = rule.get("stdout", "")
    if rule.get("stdout_bytes"):
        out += "x" * int(rule["stdout_bytes"])
    sys.stdout.write(out)
    sys.stdout.flush()
    sys.stderr.write(rule.get("stderr", ""))
    return int(rule.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main())
