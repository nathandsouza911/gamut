# Copy to .env and edit. Never commit .env.
# The private key is NOT configured here: it is mounted into the worker only, as a Compose secret.

POSTGRES_PASSWORD=change-me
GAMUT_DATABASE_URL=postgresql+psycopg://gamut:change-me@db:5432/gamut

# Public half of the credential-wrapping key pair (the API can only encrypt). Generate a pair with `gamut gen-keys`.
GAMUT_CREDENTIAL_PUBLIC_KEY=EXAMPLE-DO-NOT-USE

# Host path of the private key file, mounted into the worker only at /run/secrets/credential_private_key.
# The worker refuses to start if the key equals the literal below.
# Example private key (placeholder): EXAMPLE-DO-NOT-USE
GAMUT_PRIVATE_KEY_PATH=./secrets/credential_private_key.example

# OIDC sign-in
GAMUT_OIDC_ISSUER=https://accounts.example.com
GAMUT_OIDC_CLIENT_ID=gamut
GAMUT_OIDC_CLIENT_SECRET=change-me

# "Source code" link shown in the UI footer (AGPL-3.0 section 13). Replace OWNER with the repository owner.
GAMUT_SOURCE_URL=https://github.com/OWNER/gamut
