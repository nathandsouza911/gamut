# Copy to .env and edit. Never commit .env. Setup steps: docs/quick-start.md
#
# Compose reads this file to fill in each service's own environment (see
# docker-compose.yml); the containers do not receive the whole file. In particular the
# worker never gets GAMUT_SECRET_KEY or the OIDC secret, the web container never gets the
# credential private key, and only the one-shot migrate container gets the schema owner's
# database password.

# --- Database (use letters and digits only, for example `openssl rand -hex 32`; the
# --- values are placed into connection URLs). Required: leave no value empty.
# POSTGRES_PASSWORD is the bootstrap superuser; GAMUT never connects as it.
POSTGRES_PASSWORD=
# gamut_owner owns the schema; used by the migrate container only.
GAMUT_OWNER_DB_PASSWORD=
# gamut_app is what web and worker connect as (no UPDATE/DELETE on the audit log).
GAMUT_APP_DB_PASSWORD=
# The roles are created on the database's first start; changing these later does not
# change the passwords inside an existing database volume.

# --- Web: signs session, CSRF and preview tokens. Long random value, for example
# --- `openssl rand -hex 32`. Required.
GAMUT_SECRET_KEY=

# --- Credential key pair (X25519). Generate it once with `gamut gen-keys` as shown in
# --- docs/quick-start.md; it prints the public-key line to paste here.
# Public half (base64): the web app can only encrypt with it. The web app refuses the
# example value below.
GAMUT_CREDENTIAL_PUBLIC_KEY=EXAMPLE-DO-NOT-USE
# Host path of the private key file, mounted into the worker only (as a Compose secret
# at /run/secrets/credential_private_key). The worker refuses to start if the key is
# missing or is this example file. Set it to ./secrets/credential_private_key after
# gen-keys.
GAMUT_PRIVATE_KEY_PATH=./secrets/credential_private_key.example

# --- Break-glass owner, created on first start only (changing these later does nothing).
# --- Set a long passphrase before the first start; with no password no owner is created.
GAMUT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GAMUT_BOOTSTRAP_ADMIN_PASSWORD=

# --- OIDC sign-in (Google). Enabled when the client id and secret are both set.
# Authorized redirect URI in the Google console: <GAMUT_PUBLIC_BASE_URL>/api/auth/callback
GAMUT_OIDC_CLIENT_ID=
GAMUT_OIDC_CLIENT_SECRET=
GAMUT_OIDC_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# External https address of the panel (TLS terminates at your reverse proxy).
GAMUT_PUBLIC_BASE_URL=https://gamut.example.com

# --- Reverse proxy trust. X-Forwarded-For is believed only from these addresses; the
# --- client address it names feeds the login rate limit. The default is the gateway of
# --- the pinned Compose network (10.78.80.1), which is where a reverse proxy running on
# --- the host reaches the published port. If it is wrong, every user shares one
# --- rate-limit bucket (10 logins per minute for everybody). See docs/threat-model.md.
# GAMUT_FORWARDED_ALLOW_IPS=10.78.80.1
# If compose up fails with "Pool overlaps", pick a free subnet; the trusted proxy
# address above follows the gateway automatically.
# GAMUT_NETWORK_SUBNET=10.78.80.0/24
# GAMUT_NETWORK_GATEWAY=10.78.80.1

# --- "Source code" link in the UI footer (AGPL-3.0 section 13). If you run a modified
# --- copy, point it at your own repository. Also baked into the UI at build time as a fallback, so run
# --- `docker compose up -d --build` after changing it.
GAMUT_SOURCE_URL=https://github.com/nathandsouza911/gamut
