# Copy to .env and edit. Never commit .env.
# The private key is NOT configured here: it is mounted into the worker only, as a Compose secret.

POSTGRES_PASSWORD=change-me
# Database roles (created on first start by backend/docker/initdb/10-gamut-roles.sh).
# POSTGRES_PASSWORD is the bootstrap superuser; GAMUT never connects as it.
GAMUT_OWNER_DB_PASSWORD=change-me-owner
GAMUT_APP_DB_PASSWORD=change-me-app
# The app connects as gamut_app (no UPDATE/DELETE on the audit log).
GAMUT_DATABASE_URL=postgresql+psycopg://gamut_app:change-me-app@db:5432/gamut
# Migrations only: gamut_owner owns the schema.
GAMUT_MIGRATE_DATABASE_URL=postgresql+psycopg://gamut_owner:change-me-owner@db:5432/gamut

# Web: signs session, CSRF and preview tokens. Use a long random value.
GAMUT_SECRET_KEY=change-me

# Credential key pair (X25519). Generate it once; the worker container runs as uid 10001:
#   mkdir -p secrets && docker compose run --rm --no-deps --user "$(id -u):$(id -g)" #     -v "$PWD/secrets:/out" web gamut gen-keys /out/credential_private_key
# then make the file readable by uid 10001 only (for example: sudo chown 10001 secrets/credential_private_key).
# gen-keys writes the private key (mode 0600) and prints the GAMUT_CREDENTIAL_PUBLIC_KEY line for below.
# Public half (base64): the web app can only encrypt with it. The web app refuses the example value.
GAMUT_CREDENTIAL_PUBLIC_KEY=EXAMPLE-DO-NOT-USE

# Host path of the private key file, mounted into the worker only at /run/secrets/credential_private_key.
# The worker refuses to start if the key is missing or is the example file below.
GAMUT_PRIVATE_KEY_PATH=./secrets/credential_private_key.example

# Break-glass owner, created on first start only (changing these later does nothing).
# Set a long passphrase before the first start; with no password no owner is created.
GAMUT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GAMUT_BOOTSTRAP_ADMIN_PASSWORD=

# OIDC sign-in (Google). Enabled when the client id and secret are set.
# Authorized redirect URI in the Google console: <GAMUT_PUBLIC_BASE_URL>/api/auth/callback
GAMUT_OIDC_CLIENT_ID=
GAMUT_OIDC_CLIENT_SECRET=
GAMUT_OIDC_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# External https address of the panel (TLS terminates at your reverse proxy).
GAMUT_PUBLIC_BASE_URL=https://gamut.example.com
# Proxy addresses whose X-Forwarded-For header is trusted (comma-separated, or the
# proxy's Docker network address). The client address feeds the login rate limit.
GAMUT_FORWARDED_ALLOW_IPS=127.0.0.1

# "Source code" link shown in the UI footer (AGPL-3.0 section 13). Replace OWNER with the repository owner.
GAMUT_SOURCE_URL=https://github.com/OWNER/gamut
